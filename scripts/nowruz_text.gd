static func text(language: String, key: String) -> String:
	var offset := 1 if language == "fa" else 0
	if key.begins_with("book_") and key != "book_read":
		var index := key.trim_prefix("book_").to_int()
		var book: Array = preload("res://scripts/book_cafe.gd").BOOKS[index]
		return "%s — %s\n%s" % [book[offset], book[2 + offset], book[4 + offset]]
	return STRINGS[key][offset]
